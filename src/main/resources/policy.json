{ "version": 2, "default": "deny",
  "protectedRoles": ["postgres", "pg_*", "orders_owner", "agent_*", "dba_*"],
  "planAdmission": { "findingTypes": ["pg.excessive_privilege.owner_membership"], "targetMustEqualFindingSubject": true,
    "maxGrants": 12, "allowedPrivileges": ["USAGE","SELECT","INSERT","UPDATE","DELETE","EXECUTE"],
    "minHealthScenarios": 1, "requireGuards": ["completeness","justification","scenario_coverage","citation"] },
  "approval": { "required": true, "approverPersonas": ["dba"], "separationOfDuties": true, "expiryMinutes": 15 },
  "tools": {
    "read_role_graph":          { "allow": true },
    "read_grants":              { "allow": true },
    "read_catalog_object":      { "allow": true },
    "read_query_telemetry":     { "allow": true },
    "read_job_runs":            { "allow": true },
    "search_outcomes":          { "allow": true },
    "preflight_check":          { "allow": true, "operationStates": ["APPROVED","FAILED_NOT_APPLIED"] },
    "apply_right_size_role":    { "allow": true, "operationStates": ["APPROVED","FAILED_NOT_APPLIED"] },
    "get_operation_status":     { "allow": true },
    "assert_privileges":        { "allow": true },
    "run_negative_probe":       { "allow": true },
    "run_health_scenarios":     { "allow": true },
    "read_control_fingerprint": { "allow": true },
    "read_membership_grantor":  { "allow": true },
    "read_role_change_log":     { "allow": true },
    "reopen_finding":           { "allow": true, "findingStates": ["DRIFT_DETECTED"] } } }
